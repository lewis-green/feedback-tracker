DATABASE_URL=postgres://issue_tracker:issue_tracker@localhost:15433/issue_tracker
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
PORT=3000
# COOKIE_SECURE=0   # only for plain-HTTP internal deployments
# SHARE_RATE_LIMIT=300         # requests per 15 min per IP for the anonymous /api/share surface
# SHARE_UPLOAD_RATE_LIMIT=30   # attachment uploads per 15 min per IP within /api/share
# TRUST_PROXY=1                # number of hops to trust for X-Forwarded-For; set to match your reverse proxy
# UPLOADS_DIR=/path/to/uploads   # default: api/uploads/
